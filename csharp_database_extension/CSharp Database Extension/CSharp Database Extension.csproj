<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
		<Version>$(GitVersion)</Version>
	    <PackageId>CSharp.Database.Extension</PackageId>
        <RootNamespace>CSharp_Database_Extension</RootNamespace>
		<RepositoryUrl>https://github.com/Cosmos-CSM/fe_csharp_database</RepositoryUrl>

		<TargetFrameworks>net10.0</TargetFrameworks>
		
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageDescription>A framework extension package for CSM extended utilities related with database management, provide tools to configure easily database models and standard through organization creations.</PackageDescription>
		
		<Authors>Renato Urrea</Authors>
		<Company>Cosmos (CSM)</Company>
		
        <Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CSharp.Extension" Version="1.2.5" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>

</Project>
